# 작성: 2026-10-22 12:23 KST
# 로컬에서는 이 파일을 secrets.toml 로 복사해 키를 채운다. (secrets.toml 은 git 제외)
# Streamlit Community Cloud 에서는 앱 설정의 Secrets 칸에 같은 내용을 붙여 넣는다.
# 주의: [auth] 아래에 적은 줄은 모두 [auth]에 속하므로 최상위 키를 먼저 적고 [auth] 를 맨 뒤에 둔다.
OPENROUTER_API_KEY = ""
DATABASE_URL = ""

# 구글 로그인(선택). 비워 두면 앱이 "구글 로그인은 아직 설정되지 않아…"로 안내하고 아이디·비밀번호 로그인만 쓴다.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""        # 무작위 32자 이상(영문·숫자)
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
